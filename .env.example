# ─── LLM Config ────────────────────────────────────────────────────────────────
# Set to true during all development — only switch to false for final benchmarks
CRUCIBLE_USE_LOCAL_LLM=true

# ─── Azure (only needed when CRUCIBLE_USE_LOCAL_LLM=false) ──────────────────────
AZURE_INFERENCE_KEY=your_key_here
AZURE_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/models
AZURE_CONTENT_SAFETY_KEY=your_key_here
AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com

# ─── Database ───────────────────────────────────────────────────────────────────
# SQLite for dev (default). Switch to PostgreSQL DSN for prod.
DATABASE_URL=sqlite:///./crucible.db

# ─── Queue ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Ollama (local LLM) ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini

# ─── MCP: GitHub ────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, workflow
# Set in your shell: export GITHUB_PAT=ghp_...
# Do NOT put the real token in this file
GITHUB_PAT=ghp_your_token_here
